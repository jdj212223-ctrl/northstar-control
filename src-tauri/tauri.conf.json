{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar Control",
  "version": "2.1.0",
  "identifier": "io.github.jdj212223.northstar-control",
  "build": { "frontendDist": "../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Monitor, benchmark and tune your computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["dmg", "app", "nsis", "deb", "rpm", "appimage"],
    "linux": { "deb": { "depends": [] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
