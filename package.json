{
  "name": "northstar-control",
  "version": "1.2.9",
  "private": true,
  "author": "Northstar contributors",
  "license": "MIT",
  "description": "Cross-platform desktop hardware monitor and power control",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server/index.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/updater.cjs && node --check shared/channel.cjs && node --check electron/remote-agent.cjs && node --check electron/mac-hardware-helper.cjs && node --check server/index.cjs && node --check server/billing.cjs && node --check app/app.js && node --check docs/site.js",
    "test": "node --test",
    "package:mac": "electron-builder --mac --universal --publish never",
    "package:windows": "electron-builder --win --publish never",
    "package:linux": "electron-builder --linux --publish never",
    "package:flatpak:arm64": "electron-builder --linux flatpak --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "build": {
    "appId": "org.northstar.control",
    "productName": "Northstar Control",
    "directories": {
      "output": "build/desktop"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "shared/**/*",
      "assets/northstar.ico",
      "assets/northstar.png",
      "package.json",
      "LICENSE",
      "README.md",
      "CONTRIBUTING.md"
    ],
    "mac": {
      "icon": "assets/northstar.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "assets/northstar.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/northstar.png",
      "maintainer": "northstar-control@users.noreply.github.com",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "flatpak"
      ],
      "category": "System;Utility"
    },
    "flatpak": {
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "useWaylandFlags": true
    }
  }
}
