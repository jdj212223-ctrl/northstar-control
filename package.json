{
  "name": "northstar-control",
  "version": "1.2.3",
  "private": true,
  "author": "Northstar contributors",
  "license": "MIT",
  "description": "Cross-platform desktop hardware monitor and power control",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server/index.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/remote-agent.cjs && node --check electron/mac-hardware-helper.cjs && node --check server/index.cjs && node --check app/app.js && node --check docs/site.js",
    "test": "node --test",
    "package:mac": "electron-builder --mac --universal",
    "package:windows": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "build": {
    "appId": "org.northstar.control",
    "productName": "Northstar Control",
    "directories": {
      "output": "build/desktop"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "CONTRIBUTING.md"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System;Utility"
    }
  }
}
